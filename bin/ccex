#!/usr/bin/env bash
# ccex — "cc exchange": switch which Claude account Claude Code runs as.
# The live account is the ordinary ~/.claude; the others are parked under
# ~/.claude-profiles, sharing settings and history through symlinks.
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
CCEX_LIB=${CCEX_LIB:-$(dirname "$SELF")/../lib}
CCEX_PY="$CCEX_LIB/py"
export CCEX_BIN="$SELF"
[ -d "$CCEX_PY" ] || { printf 'ccex: cannot find its lib/ next to %s\n' "$SELF" >&2; exit 1; }

# shellcheck source=../lib/common.sh
for m in common profile limits rotate background tray; do . "$CCEX_LIB/$m.sh"; done

usage() {   # `ccex -h` for the overview, `ccex <command> -h` for one command
  case "${1:-}" in
    ls|list) cat <<'U'
ccex ls [<account>] [--force] [--json]
ccex ls -w|--watch [--every 5s] [--at N] [--refresh 15m] [--rotate]

With no account, every account as one row each -- the same table `ccex ls -w` draws,
once, followed by what rotation would do next:

  #         its number: `ccex use 3` is the whole switch; ▶ marks the live account
  POOL      `in` when rotation may choose this account, `held` when it is out of the
            rotation pool -- by you, or by rotation when it found the account spent or
            refused
  CAP       5h/weekly percentages this account counts as out of room at, if it sets its
            own (`ccex pool cap`); `-` when it follows the defaults
  ACCOUNT   the account, by address; `ccex use` takes that, its number, or its slot name
  5H        share of the 5-hour window spent, a meter with a tick where this account
            counts as out of room, and how long until it resets
  WEEKLY    the same for the week
  CHECKED   how old those numbers are; `live` means a session is reporting now
  REFRESH   how long the login itself has before it needs a browser again

The rows are in rotation's order: the live account, then the one a switch would land on,
and so on. --sort <column> orders them by one column instead -- #, pool, cap, account, 5h,
5h-reset, weekly, weekly-reset, checked, refresh, or rotation -- and the column wears ▾ on
its header. Each window is two: how spent it is, and how soon it comes back (RESETS).

--json prints the rows the table is drawn from, for anything else that wants them: every
account, or the one you name.

Reads files only — never starts a session, however stale the numbers are, unless you
ask with --force, which asks the account itself even when it is parked. Name an account to get its two windows in full instead, with clock
times: `ccex ls work`.

-w keeps the table on screen, htop-style: the reset clocks count down every second,
the bars move as your sessions report, and the rotation monitor is folded in at the
bottom — which account is next, and how long until the live one hits the cap that
sends it there. That estimate comes from how fast the window is actually climbing, so
it needs a few minutes of readings before it can say.

  --every 10s   how often the numbers behind the countdown are re-read
  --at N        threshold to predict against; defaults to whatever `--bg` is running at
  --refresh 15m allow one real check when nothing has reported for that long (off by
                default, and never while the background daemon is doing it)
  --rotate      switch here, not just report it, when the live account is out of room
  --sort COL    start ordered by that column rather than rotation's order (see `ccex ls -h`)
  --no-verify   predict, and switch, on the numbers already on file; see `ccex rotate -h`

  up/down  move the selection, enter switches to it
  right    take it out of the rotation pool, left puts it back
  0-9      or type an account's number, y to confirm (backspace edits)
  a        add an account: the browser login runs here, then the table has it
  c        cap the selected account: 5h percentage, then weekly, - for uncapped
  s        order the rows by the next column along; S turns the current order round --
           or click a column header; a click on a row selects it, the wheel moves
  +/-      re-pace it (10s, 30s, 1m, 5m, 15m, 30m)   r  re-read now    q  quit

The table is the one `ccex ls` prints (see `ccex ls -h` for its columns), redrawn as the
numbers land. `▶` marks the account you are billing, `›` the one the arrows are on. CHECKED
and REFRESH give way on a narrow terminal, then the address is shortened.

The estimate is about the 5-hour window, which is what actually stops you working; the
week only joins it once it is past 90%. Both read the same per-account caps rotation
does. Piped to a file it prints plain frames instead of drawing.
U
;;
    use) cat <<'U'
ccex use <account> [-n|--dry-run] [--no-check] [--no-report] [--anyway]

Hand the live ~/.claude slot to <account> and park whoever was there. <account> is the
number from `ccex ls`, a slot name, a full email, or any unambiguous prefix — `ccex use 3`
is the quickest.

  -n, --dry-run   say what would move, write nothing
  --no-check      neither ask the account first nor report afterwards
  --no-report     ask, but print no table -- what the live view switches with
  --anyway        switch to it even if it turns out to have no room

Sessions you already have open follow the switch.

The account you name is asked what it has left before the slot moves -- the same reading
rotation takes, through the same code, into the same trail the live view shows. If it comes
back spent, the slot goes to the next account with room instead and says so: naming an
account is not an instruction to sit at 93% while the daemon moves off it seconds later.
`--anyway` is how you say you meant it. The report afterwards reads that same answer, so
this costs one session, not two.

An account that comes back refused -- its organisation has turned Claude Code off -- is not
switched to at all, by name or otherwise, and `--anyway` does not apply: no session can start
there, so the slot would move somewhere nothing works. `ccex pool in <account>` forgets the
refusal and tries it again.
U
;;
  rotate) cat <<'U'
ccex rotate [--at 80] [-n] [--bg|--watch|--status|--log|--guesses|--stop]

Switch off the live account if it has crossed --at on the 5-hour or weekly window,
onto whichever account has the most usable room. With no flag it does that once, now.

  --at N        percentage that counts as out of room (default 80)
  -n            plan only, write nothing
  --no-verify   switch on the numbers already on file, without asking the account first

An account with a cap of its own uses that instead of --at, in both directions -- see
`ccex pool -h`.

Keep it running:

  --bg          from now on, in the background: a resident service that switches as
                soon as a session reports the number that crosses the cap
  --watch       in this terminal, one line per check; 1-6 re-pace, r checks now, q quits
  --status      whether it is running, what it costs, and what it has rotated
  --log         every switch it has made
  --guesses     every estimate it made for a quiet session, beside what turned out to be true
  --stop        remove it

  --every 10s   how often it re-reads the numbers (--bg), or prints a line (--watch)
  --refresh 15m allow one real check when nothing has reported for that long; off by
                default, because a switch now follows the data instead of a clock
  --serve       the loop --bg installs, in the foreground

`ccex ls -w` is the same thing with the whole table drawn, if you would rather watch it.

Candidates must be under --at on both windows. Among those, ranking is by what the
usage costs: used% x (time left in window / window length), 5-hour first, weekly as
the tie-break. Rotating once exits 1 if every account is spent.

A stay is not always good news. When every other account is spent and this one is still
climbing, the burn rate is no longer a countdown to a switch but a countdown to not being
able to work -- so it is said while there is still time to land what is running or lift a
cap: "about 12m of room left, and nothing else has any until ai006 in 28m (a 16m gap)".
The background daemon says it once per window, in its journal and in `--status`; the tray
says it once per window too; `ccex ls -w` counts it down. It stops at the cap: past that it
is not a warning but the nowhere-to-go the switch itself reports.

Before the slot changes hands, the account being moved to is asked what it actually has
left -- one short session on it, a few seconds. Nothing reports for a parked account, so
its numbers are as old as the last time it was live, and an account spent somewhere else
in the meantime reads as free until something asks it. One rule covers every answer: if it
cannot be asked, try the next one -- whether it turned out to have no room or would not
answer at all. Up to three are asked, a session each. When none of them will answer the slot
stays where it is: the numbers on file are no answer for an account nothing can read, because
a window past its reset reads 0% with nobody asked, so the stalest account is the one that
looks emptiest. An account that has stopped answering altogether comes out of the pool, and
one whose organisation has turned Claude Code off comes out on the first refusal.

Because the check exists, an account nothing has measured can be a candidate too, behind
every account that has been -- otherwise ranking, which needs numbers, could never reach
one. It is the one thing with no fallback: if it cannot be measured, there are no numbers
to fall back to, so it leaves the running. `--no-verify` skips the asking, and drops unmeasured accounts
with it; `-n` never asks.

Nothing is checked on a timer. A window past its reset reads 0% without asking anyone, so
the countdown keeps stale numbers honest for free. What does happen before a switch happens
near it, measured in usage rather than in time: once either of the live account's windows is
within 5 points of its cap, the account it would move to is read then -- so the ranking that
picks it is working from numbers worth trusting. That happens at most once per 5-hour window,
and a read that failed counts, so it cannot turn into a tick-by-tick check.

Deciding never starts a session: it reads what your running sessions already report, and
nothing but files. It runs while you are logged in; `loginctl enable-linger $USER` to keep
it running when you are not.
U
;;
    record) cat <<'U'
ccex record [--install]

A statusline filter: Claude Code's payload in, the same payload out, the limits in it
noted on the way past. Every running session then keeps its own account's numbers
current, and nothing has to be launched to read them. Writes at most once every 15
seconds per account.

  --install   put it in front of your statusline in settings.json, once

Installing keeps whatever statusline you already have and pipes into it; with no
statusline it installs the bundled bar — model, context, cost, both usage windows.
settings.json is backed up first, and the line that undoes it is printed. Running it
again changes nothing. Without --install, this is the filter itself:

  "statusLine": { "type": "command", "command": "ccex record | your-statusline" }
U
;;
    pool) cat <<'U'
ccex pool out <account>    stop rotating onto that account
ccex pool in <account>     let it be chosen again
ccex pool cap <account> [--5h N] [--weekly N] [--clear]

Rotation rules for one account. The login is untouched by all of them — this is about what
`ccex rotate` may do, not about signing out.

out/in is the whole account: rotation will not choose a held one, and will not move you off
one you are sitting on, whatever its limits say. `ccex use` still switches to it by name.
Held accounts are marked x in `ccex ls`.

cap is the softer version — the account stays in rotation, but counts as out of room at its
own percentage instead of at --at:

  ccex pool cap 4 --5h 60 --weekly 99   leave 40% of every 5-hour window unspent on
                                        account 4, and let its week run to 99%
  ccex pool cap work --5h 95            or run one right down before moving on
  ccex pool cap work                    the shared-account preset, 5h 60% / weekly 75%
  ccex pool cap work --clear            back to the --at default

`ccex ls work` reads a cap back, and shows what is in force now if it has begun to give way.

<account> here is the same as everywhere else: the number from `ccex ls`, a slot name, an
email, or any unambiguous prefix.

A cap applies both ways: rotation moves off that account once it crosses the cap, and will
not land on it above the cap either. Windows you don't cap keep following --at, so one
account can protect its week and share everyone else's 5-hour threshold. Capped accounts
are marked c in `ccex ls`, which also grows a CAP column showing 5h/weekly once anything is
capped -- `60/99` caps both, `-/25` only the week.

A cap protects a week, so it gives way as that week ends. What it is holding back would
expire at the reset either way, unspent by you or by anyone else sharing the account:

  more than two days left   the cap you set
  from 48h                  five points every twelve hours, up to 99%
  under 5h                  the default, 90/99 -- one window left to spend the week in

The 5-hour ceiling is the one anyone else on that account feels, so it alone holds until
the last band. The CAP column shows the percentages in force and marks them * while they
are not the ones you set; `ccex ls <account>` says so in words. Nothing is remembered and
nothing needs resetting: this is the clock being read, so the cap you set is back the
moment the new week starts.
U
;;
    tray) cat <<'U'
ccex tray [--install|--stop|--status]

ccex in the top bar: the live account and what it has left as the panel label, every other
account one click below it, and the switch happens where you are rather than in a terminal.

  --install   start it now and at every login
  --stop      take it out of the top bar again
  --status    whether it is running

The menu is the live view's table -- the number, the account, then each window as a
percentage, its meter and the clock it resets on -- ordered by what the 5-hour window has
left rather than by number, so the account worth switching to is the one nearest the top. A menu label is plain text drawn in the desktop's own
font, where no two letters are the same width, so every cell is measured and padded to one
width rather than counted -- which is what lets the columns after a name line up at all.

The meters have three shades where the table has two, because a menu row has no colour and
no CAP column to explain itself with:

  ████████   spent
  ▒▒▒▒▒▒▒▒   yours to spend, until rotation moves off
  ░░░░░░░░   past that -- a cap you set, or the threshold the daemon is running at

So an account capped at 60% shows four cells it will never be allowed to spend.

A row switches to that account through `ccex use`: the same reading before it moves, the
same refusals, the same handover to an account with room when the one you picked has none.

Notifications are for the two things worth interrupting you: the live account changed --
by your click, by a terminal, or by rotation while you were elsewhere -- or a switch was
refused, in the words `ccex use` refused it in. Anything that moved nothing says nothing.
There is one more, before the fact: when the live account comes within 5 points of where
rotation would move off it, the panel says so once, and again only when that window has
started over.

`Rotate now` is `ccex rotate`.

Reading costs nothing: the numbers come from the same files `ccex ls` reads, every ten
seconds, and no session is ever started to draw a panel. They are as current as whatever is
feeding them, which for a statusline with `ccex record` in it is every render.

It needs a desktop that draws tray icons -- GNOME does not on its own, but Ubuntu's
AppIndicator extension is on by default -- and python's appindicator typelib:

  sudo apt install gir1.2-ayatanaappindicator3-0.1
U
;;
    add) cat <<'U'
ccex add [<name>] [--email you@example.com]

Browser login for another account, parked under ~/.claude-profiles/ for later. Its
settings, history and plugins are symlinked to your real ones.

With no name, the slot is named after whoever logs in -- ada@acme.example parks as
`acme`. Logging in as an account you already have re-authenticates that slot instead of
making a second one, which is what an expired REFRESH date calls for. Naming it yourself
still works, and `ccex add <existing>` re-authenticates that slot.
U
;;
    run) cat <<'U'
ccex run <account> [claude args...]

Launch claude as a parked account, leaving the live one alone.
U
;;
    env) cat <<'U'
ccex env <account>

Print the CLAUDE_CONFIG_DIR line for that account: eval "$(ccex env work)"
U
;;
    *) cat <<'USAGE'
ccex — switch which Claude account Claude Code runs as

  ccex ls [<account>]         every account, or one in full; * marks the live one
  ccex ls -w                  that table live, counting down, with the next switch on it
  ccex use <account>          make that account live (-n to plan only)
  ccex rotate                 switch off the live account if it is out of room (--at 80)
  ccex rotate --bg            keep doing that in the background, the moment usage says so
  ccex pool out|in <account>  take an account out of the rotation pool, or put it back
  ccex pool cap <account>     how far rotation may spend that one account (--5h, --weekly)
  ccex add [<name>]           browser login for another account, parked for later
  ccex rm <account>           delete a parked account and its login
  ccex run <account> [args]   run claude as a parked account, leaving the live one alone
  ccex env <account>          eval "$(ccex env work)" to set CLAUDE_CONFIG_DIR
  ccex tray --install         the same table in the top bar, switching from the menu
  ccex record                 statusline filter that keeps limits current for free
  ccex record --install       wire that filter into your statusline, once

  ccex <command> -h           what that command does, and its flags

<account> is the number from `ccex ls`, a slot name, a full email, or any unambiguous
prefix of either. Numbers are keyed to the account, so they survive rotations.

The live account is the ordinary ~/.claude; the rest are parked under ~/.claude-profiles
with settings, history and plugins symlinked back, so a switch changes nothing but who is
billed. `use` moves one key, claudeAiOauth, plus the matching identity block, and backs up
what it touches to ~/.claude-profiles/.backups/<timestamp>/. Sessions you already have
open follow the switch: they re-read the credential and bill the new account from their
next request on.

For live usage numbers at no cost, `ccex record --install` puts `ccex record |` in front of
your statusLine command in settings.json — see `ccex record -h`.
USAGE
;;
  esac
}

cmd=${1:-ls}; shift || true
case "$cmd" in
  run)                                 # hands its arguments to claude, -h included
    case "${1:-}" in -h|--help) usage "$cmd"; exit 0 ;; esac ;;
  *)
    for a in "$@"; do
      case "$a" in -h|--help) usage "$cmd"; exit 0 ;; esac
    done ;;
esac
case "$cmd" in
  ls|list)
    case " $* " in *" -w "*|*" --watch "*)     # the live view; everything below is the one-shot table
      wargs=()
      while [ $# -gt 0 ]; do
        case "$1" in
          -w|--watch) ;;
          --every|--refresh) [ $# -ge 2 ] || die "$1 needs a duration like 5s"
                             wargs+=("$1" "$(secs "$2")"); shift ;;
          --at)       [ $# -ge 2 ] || die "--at needs a percentage"; wargs+=(--at "$2"); shift ;;
          --sort)     [ $# -ge 2 ] || die "--sort needs a column (try: ccex ls -h)"; wargs+=(--sort "$2"); shift ;;
          --rotate|--once|--no-verify) wargs+=("$1") ;;
          *)          die "ls: '$1' is not a --watch option (try: ccex ls -h)" ;;
        esac
        shift
      done
      exec python3 "$CCEX_PY/watch.py" ${wargs[@]+"${wargs[@]}"} ;;
    esac
    how=--no-launch; case " $* " in *" --force "*) how=--force ;; esac
    case " $* " in *" --json "*)      # the rows the table is drawn from, for anything that reads
      all=--all                      # ccex -- every account, unless one is named, in either order
      for a in "$@"; do case "$a" in -*) ;; *) all= ;; esac; done
      limits --quiet "$how" ${all:+--all} "$@"; exit 0 ;;
    esac
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then limits --quiet "$how" "$@"; exit 0; fi
    # One table, drawn by the watch view: `ccex ls` is `ccex ls -w` once, so the two never
    # disagree about a column. --force asks every account first, then the table reads it.
    [ "$how" = --force ] && limits --all --tsv --force >/dev/null
    sort=()
    while [ $# -gt 0 ]; do
      case "$1" in --sort) [ $# -ge 2 ] || die "--sort needs a column (try: ccex ls -h)"; sort=(--sort "$2"); shift ;; esac
      shift
    done
    exec python3 "$CCEX_PY/watch.py" --once ${sort[@]+"${sort[@]}"}
    ;;
  add)
    # A name is optional: the account knows its own, we just cannot ask until it has
    # logged in. So with no name the login happens in a scratch slot, and the slot is
    # named after the account that turns up in it.
    name=; case "${1:-}" in ''|-*) ;; *) name=$1; shift ;; esac
    scratch=
    if [ -n "$name" ]; then
      d=$(dir_for "$name")
      [ "$d" = "$BASE" ] && die "'default' is the existing ~/.claude account"
    else
      scratch="$ROOT/.adding"; d=$scratch
      rm -rf "$scratch"; mkdir -p "$scratch"
    fi
    link_shared "$d"
    seed "$d"
    printf 'ccex: logging in%s\n' "${name:+ to profile $name ($d)}" >&2
    CLAUDE_CONFIG_DIR="$d" claude auth login "$@" || {
      [ -n "$scratch" ] && rm -rf "$scratch"; die "login did not finish; nothing was added"; }
    if [ -n "$scratch" ]; then
      IFS=$'\t' read -r email _ < <(info "$scratch")
      case "$email" in ''|-) rm -rf "$scratch"; die "no account was logged in" ;; esac
      known=
      while read -r p; do            # the same account again is a re-authentication
        IFS=$'\t' read -r e _ < <(info "$(dir_for "$p")")
        [ "$e" = "$email" ] && { known=$p; break; }
      done < <(profiles)
      if [ "$known" = default ]; then
        rm -rf "$scratch"
        printf 'ccex: %s is the account you are already running; nothing to park\n' "$email"
      elif [ -n "$known" ]; then
        rm -rf "$ROOT/$known" && mv "$scratch" "$ROOT/$known"
        printf 'ccex: re-authenticated %s (%s)\n' "$email" "$known"
      else
        slot=$(python3 -c 'import sys, ccexlib; print(ccexlib.canon(sys.argv[1]))' "$email")
        target="$ROOT/$slot"; n=2
        while [ -e "$target" ]; do target="$ROOT/$slot-$n"; n=$((n + 1)); done
        mv "$scratch" "$target"
        printf 'ccex: added %s, parked as %s\n' "$email" "$(basename "$target")"
      fi
    fi
    ;;
  run)
    [ $# -ge 1 ] || die "usage: ccex run <name> [claude args...]"
    d=$(dir_for "$1"); shift
    [ -d "$d" ] || die "no such profile dir: $d (run: ccex add)"
    if [ "$d" = "$BASE" ]; then exec env -u CLAUDE_CONFIG_DIR claude "$@"
    else link_shared "$d"; exec env CLAUDE_CONFIG_DIR="$d" claude "$@"; fi
    ;;
  env)
    [ $# -ge 1 ] || die "usage: eval \"\$(ccex env <name>)\""
    d=$(dir_for "$1")
    if [ "$d" = "$BASE" ]; then printf 'unset CLAUDE_CONFIG_DIR\n'
    else printf 'export CLAUDE_CONFIG_DIR=%q\n' "$d"; fi
    ;;
  record)
    case "${1:-}" in                     # --install must be handled before record() reads stdin
      --install) py statusline ;;
      '')        record ;;
      *)         die "record: unknown option '$1' (try: ccex record -h)" ;;
    esac
    ;;
  pool)
    case "${1:-}" in
      in|out) [ $# -ge 2 ] || die "usage: ccex pool $1 <account>"; py pool "$1" "$2" ;;
      cap)    [ $# -ge 2 ] || die "usage: ccex pool cap <account> [--5h N] [--weekly N] [--clear]"
              py pool "$@" ;;
      *)      die "usage: ccex pool in|out|cap <account>" ;;
    esac
    ;;
  rotate)
    mode=once; rest=()
    for a in "$@"; do
      case "$a" in
        --bg)     mode=install ;;
        --watch)  mode=watch ;;
        --serve)  mode=serve ;;      # what --bg installs: resident, switches on data change
        --status) mode=status ;;
        --log)    mode=log ;;
        --guesses) mode=guesses ;;
        --stop)   mode=stop ;;
        --tick)   mode=tick ;;      # what the timer runs: rotate once, then write the log
        --at|--every|--refresh|--max-age|-n|--dry-run|--no-launch|--no-verify)
                  rest+=("$a") ;;
        -*)       die "rotate: unknown option '$a' (try: ccex rotate -h)" ;;
        *)        rest+=("$a") ;;
      esac
    done
    if [ "$mode" = once ]; then rotate ${rest[@]+"${rest[@]}"}
    else monitor "$mode" ${rest[@]+"${rest[@]}"}; fi
    ;;
  use)
    [ $# -ge 1 ] || die "usage: ccex use <account> [--dry-run] [--no-check] [--no-report]"
    check=1; report=1; dry=0; anyway=0; target=
    for a in "$@"; do
      case "$a" in
        --no-check)     check=0; report=0 ;;
        --no-report)    report=0 ;;   # ask, but keep the table out of a TUI
        --anyway)       anyway=1 ;;   # a spent account, on purpose
        -n|--dry-run)   dry=1 ;;
        -*)             die "use: unknown option '$a' (try: ccex use -h)" ;;
        *)              [ -n "$target" ] && die "use takes one account, got '$target' and '$a'"; target=$a ;;
      esac
    done
    [ -n "$target" ] || die "usage: ccex use <account> [--dry-run] [--no-check]"
    if [ "$dry" = 1 ]; then
      use_acct "$target" --dry-run
      exit 0
    fi
    # Ask the account you named what it has left before the slot moves, not after: a switch
    # onto a spent account is worth knowing about while it is still a keystroke away. It is
    # `use_acct` that does it, through the same `ask()` rotation uses, so it happens after the
    # name has been resolved -- an account that does not exist reports once, one already live
    # forks no session behind the session you are typing in, and the live view sees the same
    # trail either way.
    rc=0
    do_use "$target" $([ "$check" = 1 ] && echo --ask) \
      $([ "$anyway" = 1 ] && echo --anyway) \
      $([ "$report" = 1 ] || echo --no-check) || rc=$?
    [ "$rc" = 3 ] && exit 0        # use_acct already said it was live; that is not a failure
    exit "$rc"
    ;;
  tray)
    mode=run
    for a in "$@"; do
      case "$a" in
        --install) mode=install ;;
        --stop)    mode=stop ;;
        --status)  mode=status ;;
        *)         die "tray: unknown option '$a' (try: ccex tray -h)" ;;
      esac
    done
    tray "$mode"
    ;;
  rm)
    [ $# -ge 1 ] || die "usage: ccex rm <name>"
    d=$(dir_for "$1")
    [ "$d" = "$BASE" ] && die "refusing to delete ~/.claude"
    [ -d "$d" ] || die "no such profile: $1"
    printf 'Delete %s (credentials + that profile'"'"'s own state; shared dirs are symlinks and survive)? [y/N] ' "$d"
    read -r a; [ "$a" = y ] || die "aborted"
    py forget "$d" || true      # release its number and pool entry before the slot goes
    rm -rf "$d"
    ;;
  -h|--help|help)
    usage "${1:-}"
    ;;
  *) die "unknown command '$cmd' (try: ccex --help)" ;;
esac