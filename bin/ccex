#!/usr/bin/env bash
# ccex — "cc exchange": switch which Claude account Claude Code runs as.
# The live account is the ordinary ~/.claude; the others are parked under
# ~/.claude-profiles, sharing settings and history through symlinks.
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
CCEX_LIB=${CCEX_LIB:-$(dirname "$SELF")/../lib}
CCEX_PY="$CCEX_LIB/py"
export CCEX_BIN="$SELF"
[ -d "$CCEX_PY" ] || { printf 'ccex: cannot find its lib/ next to %s\n' "$SELF" >&2; exit 1; }

# shellcheck source=../lib/common.sh
for m in common profile limits rotate monitor; do . "$CCEX_LIB/$m.sh"; done

usage() {   # `ccex -h` for the overview, `ccex <command> -h` for one command
  case "${1:-}" in
    ls|list) cat <<'U'
ccex ls — every account, one row each

  ACCOUNT   slot name; * marks the live one
  TOKEN     access token: active, or stale until something uses the account
  REFRESH   when the login itself expires and needs a browser again
  5H        share of the 5-hour window spent, and how long until it resets
  WEEKLY    the same for the week
  CHECKED   how old those numbers are; `live` means a session is reporting now

Reads files only — never starts a session, however stale the numbers are.
U
;;
    use) cat <<'U'
ccex use <account> [-n|--dry-run] [--no-check]

Hand the live ~/.claude slot to <account> and park whoever was there. <account> is a
slot name, a full email, or any unambiguous prefix of either.

  -n, --dry-run   say what would move, write nothing
  --no-check      skip the limits report afterwards

Sessions you already have open follow the switch.
U
;;
    rotate) cat <<'U'
ccex rotate [--at 80] [-n|--dry-run] [--no-launch] [--max-age <seconds>]

Switch off the live account if it has crossed --at on the 5-hour or weekly window,
onto whichever account has the most usable room.

  --at N        percentage that counts as out of room (default 80)
  -n            plan only
  --no-launch   decide from what is already known, never start a session
  --max-age N   under --no-launch, still check numbers older than N seconds

Candidates must be under --at on both windows. Among those, ranking is by what the
usage costs: used% x (time left in window / window length), 5-hour first, weekly as
the tie-break. Exits 1 if every account is spent.
U
;;
    monitor) cat <<'U'
ccex monitor <subcommand> [--every 5m] [--at 80] [--refresh 15m]

  install     systemd user timer that runs `ccex rotate` on a schedule
  watch       follow it in this terminal; 1-6 re-pace, r checks now, q quits
  status      when it last ran, and what it has rotated
  log         every switch it has made
  stop        pause the timer      uninstall   remove it
  tick        one round, which is what the timer calls

  --every     how often to check (install, watch)
  --at        threshold to rotate at
  --refresh   how stale numbers may get before one real check is worth it

The timer runs while you are logged in; `loginctl enable-linger $USER` to keep it
running when you are not.
U
;;
    limits|usage) cat <<'U'
ccex limits [<account>] [--all] [--quiet] [--force] [--no-launch] [--max-age <seconds>]

The 5-hour and weekly windows in full, with reset clock times.

  --all         every account rather than the live one
  --quiet       the two-line form `ccex use` prints
  --force       start a session to check, even if something is reporting
  --no-launch   never start a session; report what is already known
  --max-age N   under --no-launch, allow one check for numbers older than N seconds

Parked accounts are never launched for. A window whose reset has passed reads 0%.
U
;;
    record) cat <<'U'
ccex record

A statusline filter: Claude Code's payload in, the same payload out, the limits in it
noted on the way past. Put it in front of your statusline in settings.json:

  "statusLine": { "type": "command", "command": "ccex record | your-statusline" }

Every running session then keeps its own account's numbers current, and nothing has
to be launched to read them. Writes at most once every 15 seconds per account.
U
;;
    add) cat <<'U'
ccex add <name> [--email you@example.com]

Browser login for another account, parked under ~/.claude-profiles/<name>/ for later.
Its settings, history and plugins are symlinked to your real ones.
U
;;
    run) cat <<'U'
ccex run <account> [claude args...]

Launch claude as a parked account, leaving the live one alone.
U
;;
    env) cat <<'U'
ccex env <account>

Print the CLAUDE_CONFIG_DIR line for that account: eval "$(ccex env work)"
U
;;
    *) cat <<'USAGE'
ccex — switch which Claude account Claude Code runs as

Everyday:
  ccex ls                     list accounts; * marks the live one
  ccex use <account> [-n]     make that account live (-n / --dry-run: plan only)
  ccex rotate [--at 80] [-n]  if the live account is near its 5h or weekly limit, switch to
                                the account with the most room left
  ccex monitor install        rotate automatically in the background (--every 5m, --at 80,
                                --refresh 15m: how stale numbers may get before a real check)
  ccex monitor watch          follow it live in this terminal (--every 5m; 1-6 re-pace
                                it while running, r checks now, q quits)
  ccex monitor status|stop|log what it has been doing
  ccex limits [<account>|--all] 5-hour and weekly usage limits, with reset times
                                (add --force to re-check even if the numbers look fresh)
  ccex add <name>             browser login for another account, parked for later

Occasional:
  ccex status <account>       claude auth status for one account
  ccex login|logout <account> re-auth or drop one account's credential
  ccex rename <old> <new>     rename a parked slot
  ccex rm <account>           delete a parked slot and its credential
  ccex run <account> [args]   launch claude as a parked account, leaving the live one alone
  ccex env <account>          eval "$(ccex env work)" to set CLAUDE_CONFIG_DIR
  ccex which | path <account> | link --all | seed <account>

Live limits from your statusline (optional, no extra process):
  put `ccex record |` at the front of your statusLine command in settings.json, e.g.
  "command": "ccex record | ~/.claude/statusline-command.sh"
  Every running session then keeps its own account's numbers current, and `ccex limits`
  reads them instead of launching anything.

<account> is a slot name, a full email, or any unambiguous prefix of either.

How it works: the live account is the ordinary ~/.claude. `use` moves only the
claudeAiOauth key — the parked account's in, the live one's out to
~/.claude-profiles/<email-local-part>/ — and moves the matching identity block with it.
Settings, history, plugins and MCP tokens are untouched, so a switch changes nothing but
who is billed. Each account's browser login happens once, ever; its refresh token lives
in its own slot. Every write backs up to ~/.claude-profiles/.backups/<timestamp>/.
Sessions you already have open follow the switch: they re-read the credential, so they
bill the new account from their next request on.
USAGE
;;
  esac
}

cmd=${1:-ls}; shift || true
case "$cmd" in
  run|login|logout|status)             # these hand their arguments to claude, -h included
    case "${1:-}" in -h|--help) usage "$cmd"; exit 0 ;; esac ;;
  *)
    for a in "$@"; do
      case "$a" in -h|--help) usage "$cmd"; exit 0 ;; esac
    done ;;
esac
case "$cmd" in
  ls|list)
    cur="${CLAUDE_CONFIG_DIR:-$BASE}"
    declare -A FIVE SEVEN WHEN
    while IFS=$'\t' read -r n f s w; do FIVE[$n]=$f; SEVEN[$n]=$s; WHEN[$n]=$w; done \
      < <(limits --all --tsv --no-launch)
    printf '%-20s %-30s %-7s %-7s %-8s %-22s %-26s %s\n' \
      ACCOUNT EMAIL TIER TOKEN REFRESH 5H WEEKLY CHECKED
    while read -r p; do
      d=$(dir_for "$p")
      mark=' '; [ "$(readlink -f "$d" 2>/dev/null)" = "$(readlink -f "$cur" 2>/dev/null)" ] && mark='*'
      IFS=$'\t' read -r email tier state rstate < <(info "$d")
      printf '%s%-19s %-30s %-7s %-7s %-8s %s %s %s\n' \
        "$mark" "$p" "$email" "$tier" "$state" "$rstate" \
        "${FIVE[$p]:--}" "${SEVEN[$p]:--}" "${WHEN[$p]:--}"
    done < <(profiles)
    ;;
  add)
    [ $# -ge 1 ] || die "usage: ccex add <name> [--email you@example.com]"
    name=$1; shift
    d=$(dir_for "$name")
    [ "$d" = "$BASE" ] && die "'default' is the existing ~/.claude account"
    link_shared "$d"
    seed "$d"
    printf 'ccex: logging in to profile %s (%s)\n' "$name" "$d" >&2
    CLAUDE_CONFIG_DIR="$d" claude auth login "$@"
    ;;
  login|logout|status)
    [ $# -ge 1 ] || die "usage: ccex $cmd <name>"
    d=$(dir_for "$1"); shift
    if [ "$d" = "$BASE" ]; then env -u CLAUDE_CONFIG_DIR claude auth "$cmd" "$@"
    else CLAUDE_CONFIG_DIR="$d" claude auth "$cmd" "$@"; fi
    ;;
  run)
    [ $# -ge 1 ] || die "usage: ccex run <name> [claude args...]"
    d=$(dir_for "$1"); shift
    [ -d "$d" ] || die "no such profile dir: $d (run: ccex add)"
    if [ "$d" = "$BASE" ]; then exec env -u CLAUDE_CONFIG_DIR claude "$@"
    else link_shared "$d"; exec env CLAUDE_CONFIG_DIR="$d" claude "$@"; fi
    ;;
  env)
    [ $# -ge 1 ] || die "usage: eval \"\$(ccex env <name>)\""
    d=$(dir_for "$1")
    if [ "$d" = "$BASE" ]; then printf 'unset CLAUDE_CONFIG_DIR\n'
    else printf 'export CLAUDE_CONFIG_DIR=%q\n' "$d"; fi
    ;;
  link)
    if [ "${1:-}" = "--all" ]; then while read -r p; do link_shared "$(dir_for "$p")"; done < <(profiles)
    else [ $# -ge 1 ] || die "usage: ccex link <name>|--all"; link_shared "$(dir_for "$1")"; fi
    ;;
  seed)
    [ $# -ge 1 ] || die "usage: ccex seed <name>"
    seed "$(dir_for "$1")"
    ;;
  record)
    record
    ;;
  limits|usage)
    limits "$@"
    ;;
  rotate)
    rotate "$@"
    ;;
  monitor)
    monitor "$@"
    ;;
  use)
    [ $# -ge 1 ] || die "usage: ccex use <account> [--dry-run] [--no-check]"
    check=1; dry=0; target=''; flags=()
    for a in "$@"; do
      case "$a" in
        --no-check)     check=0 ;;
        -n|--dry-run)   dry=1; flags+=("$a") ;;
        -*)             flags+=("$a") ;;
        *)              [ -n "$target" ] && die "use takes one account, got '$target' and '$a'"; target=$a ;;
      esac
    done
    [ -n "$target" ] || die "usage: ccex use <account> [--dry-run] [--no-check]"
    if [ "$dry" = 1 ]; then
      use_acct "$target" "${flags[@]+"${flags[@]}"}"
      exit 0
    fi
    rc=0
    do_use "$target" $([ "$check" = 1 ] || echo --no-check) || rc=$?
    [ "$rc" = 3 ] && exit 0        # use_acct already said it was live; that is not a failure
    exit "$rc"
    ;;
  rename)
    [ $# -ge 2 ] || die "usage: ccex rename <old> <new>"
    o=$(dir_for "$1"); n=$(dir_for "$2")
    [ "$o" = "$BASE" ] || [ "$n" = "$BASE" ] && die "cannot rename the default slot"
    [ -d "$o" ] || die "no such profile: $1"
    [ -e "$n" ] && die "already exists: $2"
    mv "$o" "$n"
    ;;
  which) printf '%s\n' "${CLAUDE_CONFIG_DIR:-$BASE (default)}" ;;
  path)  dir_for "${1:-default}" ;;
  rm)
    [ $# -ge 1 ] || die "usage: ccex rm <name>"
    d=$(dir_for "$1")
    [ "$d" = "$BASE" ] && die "refusing to delete ~/.claude"
    [ -d "$d" ] || die "no such profile: $1"
    printf 'Delete %s (credentials + that profile'"'"'s own state; shared dirs are symlinks and survive)? [y/N] ' "$d"
    read -r a; [ "$a" = y ] || die "aborted"
    rm -rf "$d"
    ;;
  -h|--help|help)
    usage "${1:-}"
    ;;
  *) die "unknown command '$cmd' (try: ccex --help)" ;;
esac