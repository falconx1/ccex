#!/usr/bin/env bash
# ccex — "cc exchange": switch which Claude account Claude Code runs as.
# The live account is the ordinary ~/.claude; the others are parked under
# ~/.claude-profiles, sharing settings and history through symlinks.
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
CCEX_LIB=${CCEX_LIB:-$(dirname "$SELF")/../lib}
CCEX_PY="$CCEX_LIB/py"
export CCEX_BIN="$SELF"
[ -d "$CCEX_PY" ] || { printf 'ccex: cannot find its lib/ next to %s\n' "$SELF" >&2; exit 1; }

# shellcheck source=../lib/common.sh
for m in common profile limits rotate background; do . "$CCEX_LIB/$m.sh"; done

usage() {   # `ccex -h` for the overview, `ccex <command> -h` for one command
  case "${1:-}" in
    ls|list) cat <<'U'
ccex ls [<account>] [--force]

With no account, every account as one row each:

  #         its number: `ccex use 3` is the whole switch
  ACCOUNT   slot name; * marks the live one, x one held out of the rotation pool
  TOKEN     access token: active, or stale until something uses the account
  REFRESH   when the login itself expires and needs a browser again
  5H        share of the 5-hour window spent, and how long until it resets
  WEEKLY    the same for the week
  CHECKED   how old those numbers are; `live` means a session is reporting now

Reads files only — never starts a session, however stale the numbers are, unless you
ask with --force. Name an account to get its two windows in full instead, with clock
times: `ccex ls work`.
U
;;
    use) cat <<'U'
ccex use <account> [-n|--dry-run] [--no-check]

Hand the live ~/.claude slot to <account> and park whoever was there. <account> is the
number from `ccex ls`, a slot name, a full email, or any unambiguous prefix — `ccex use 3`
is the quickest.

  -n, --dry-run   say what would move, write nothing
  --no-check      skip the limits report afterwards

Sessions you already have open follow the switch.
U
;;
  rotate) cat <<'U'
ccex rotate [--at 80] [-n] [--bg|--watch|--status|--log|--stop]

Switch off the live account if it has crossed --at on the 5-hour or weekly window,
onto whichever account has the most usable room. With no flag it does that once, now.

  --at N        percentage that counts as out of room (default 80)
  -n            plan only, write nothing

Keep it running:

  --bg          from now on, in the background, on a systemd user timer
  --watch       in this terminal; 1-6 re-pace it, r checks now, q quits
  --status      when it last ran, and what it has rotated
  --log         every switch it has made
  --stop        remove the timer

  --every 5m    how often (with --bg or --watch)
  --refresh 15m how stale numbers may get before one real check is worth it

Candidates must be under --at on both windows. Among those, ranking is by what the
usage costs: used% x (time left in window / window length), 5-hour first, weekly as
the tie-break. Rotating once exits 1 if every account is spent.

Running in the background never starts a session to poll: it decides from what your
running sessions already report, and only checks for real once nothing has reported
for --refresh. The timer runs while you are logged in; `loginctl enable-linger $USER`
to keep it running when you are not.
U
;;
    record) cat <<'U'
ccex record

A statusline filter: Claude Code's payload in, the same payload out, the limits in it
noted on the way past. Put it in front of your statusline in settings.json:

  "statusLine": { "type": "command", "command": "ccex record | your-statusline" }

Every running session then keeps its own account's numbers current, and nothing has
to be launched to read them. Writes at most once every 15 seconds per account.
U
;;
    pool) cat <<'U'
ccex pool out <account>    stop rotating onto that account
ccex pool in <account>     let it be chosen again

Its login is kept either way — this is about whether `ccex rotate` may pick it, not about
signing out. `ccex use` still switches to a held account when you ask for it by name, and
rotation will still move you off one that runs out of room; being held only means it is
never a destination. Held accounts are marked x in `ccex ls`.
U
;;
    add) cat <<'U'
ccex add <name> [--email you@example.com]

Browser login for another account, parked under ~/.claude-profiles/<name>/ for later.
Its settings, history and plugins are symlinked to your real ones.

Run it again on a name that already exists to re-authenticate that account, which is
what an expired REFRESH date calls for.
U
;;
    run) cat <<'U'
ccex run <account> [claude args...]

Launch claude as a parked account, leaving the live one alone.
U
;;
    env) cat <<'U'
ccex env <account>

Print the CLAUDE_CONFIG_DIR line for that account: eval "$(ccex env work)"
U
;;
    *) cat <<'USAGE'
ccex — switch which Claude account Claude Code runs as

  ccex ls [<account>]         every account, or one in full; * marks the live one
  ccex use <account>          make that account live (-n to plan only)
  ccex rotate                 switch off the live account if it is out of room (--at 80)
  ccex rotate --bg            keep doing that in the background; --watch|--status|--log|--stop
  ccex pool out|in <account>  take an account out of the rotation pool, or put it back
  ccex add <name>             browser login for another account, parked for later
  ccex rm <account>           delete a parked account and its login
  ccex run <account> [args]   run claude as a parked account, leaving the live one alone
  ccex env <account>          eval "$(ccex env work)" to set CLAUDE_CONFIG_DIR
  ccex record                 statusline filter that keeps limits current for free

  ccex <command> -h           what that command does, and its flags

<account> is the number from `ccex ls`, a slot name, a full email, or any unambiguous
prefix of either. Numbers are keyed to the account, so they survive rotations.

The live account is the ordinary ~/.claude; the rest are parked under ~/.claude-profiles
with settings, history and plugins symlinked back, so a switch changes nothing but who is
billed. `use` moves one key, claudeAiOauth, plus the matching identity block, and backs up
what it touches to ~/.claude-profiles/.backups/<timestamp>/. Sessions you already have
open follow the switch: they re-read the credential and bill the new account from their
next request on.

For live usage numbers at no cost, put `ccex record |` in front of your statusLine command
in settings.json — see `ccex record -h`.
USAGE
;;
  esac
}

cmd=${1:-ls}; shift || true
case "$cmd" in
  run)                                 # hands its arguments to claude, -h included
    case "${1:-}" in -h|--help) usage "$cmd"; exit 0 ;; esac ;;
  *)
    for a in "$@"; do
      case "$a" in -h|--help) usage "$cmd"; exit 0 ;; esac
    done ;;
esac
case "$cmd" in
  ls|list)
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then limits --quiet "$@"; exit 0; fi
    cur="${CLAUDE_CONFIG_DIR:-$BASE}"
    how=--no-launch; case " $* " in *" --force "*) how=--force ;; esac
    declare -A ID FIVE SEVEN WHEN HELD
    while IFS=$'\t' read -r n i f s w h; do
      ID[$n]=$i; FIVE[$n]=$f; SEVEN[$n]=$s; WHEN[$n]=$w; HELD[$n]=$h
    done < <(limits --all --tsv "$how")
    printf '%-3s %-20s %-30s %-7s %-7s %-8s %-22s %-26s %s\n' \
      '#' ACCOUNT EMAIL TIER TOKEN REFRESH 5H WEEKLY CHECKED
    while read -r p; do
      d=$(dir_for "$p")
      mark=' '
      [ "${HELD[$p]:-}" = held ] && mark='x'
      [ "$(readlink -f "$d" 2>/dev/null)" = "$(readlink -f "$cur" 2>/dev/null)" ] && mark='*'
      IFS=$'\t' read -r email tier state rstate < <(info "$d")
      printf '%-3s %s%-19s %-30s %-7s %-7s %-8s %s %s %s\n' \
        "${ID[$p]:--}" "$mark" "$p" "$email" "$tier" "$state" "$rstate" \
        "${FIVE[$p]:--}" "${SEVEN[$p]:--}" "${WHEN[$p]:--}"
    done < <(profiles) | sort -n        # by id, so the numbers you type read in order
    ;;
  add)
    [ $# -ge 1 ] || die "usage: ccex add <name> [--email you@example.com]"
    name=$1; shift
    d=$(dir_for "$name")
    [ "$d" = "$BASE" ] && die "'default' is the existing ~/.claude account"
    link_shared "$d"
    seed "$d"
    printf 'ccex: logging in to profile %s (%s)\n' "$name" "$d" >&2
    CLAUDE_CONFIG_DIR="$d" claude auth login "$@"
    ;;
  run)
    [ $# -ge 1 ] || die "usage: ccex run <name> [claude args...]"
    d=$(dir_for "$1"); shift
    [ -d "$d" ] || die "no such profile dir: $d (run: ccex add)"
    if [ "$d" = "$BASE" ]; then exec env -u CLAUDE_CONFIG_DIR claude "$@"
    else link_shared "$d"; exec env CLAUDE_CONFIG_DIR="$d" claude "$@"; fi
    ;;
  env)
    [ $# -ge 1 ] || die "usage: eval \"\$(ccex env <name>)\""
    d=$(dir_for "$1")
    if [ "$d" = "$BASE" ]; then printf 'unset CLAUDE_CONFIG_DIR\n'
    else printf 'export CLAUDE_CONFIG_DIR=%q\n' "$d"; fi
    ;;
  record)
    record
    ;;
  pool)
    case "${1:-}" in
      in|out) [ $# -ge 2 ] || die "usage: ccex pool $1 <account>"; py pool "$1" "$2" ;;
      *)      die "usage: ccex pool in|out <account>" ;;
    esac
    ;;
  rotate)
    mode=once; rest=()
    for a in "$@"; do
      case "$a" in
        --bg)     mode=install ;;
        --watch)  mode=watch ;;
        --status) mode=status ;;
        --log)    mode=log ;;
        --stop)   mode=stop ;;
        --tick)   mode=tick ;;      # what the timer runs: rotate once, then write the log
        *)        rest+=("$a") ;;
      esac
    done
    if [ "$mode" = once ]; then rotate ${rest[@]+"${rest[@]}"}
    else monitor "$mode" ${rest[@]+"${rest[@]}"}; fi
    ;;
  use)
    [ $# -ge 1 ] || die "usage: ccex use <account> [--dry-run] [--no-check]"
    check=1; dry=0; target=
    for a in "$@"; do
      case "$a" in
        --no-check)     check=0 ;;
        -n|--dry-run)   dry=1 ;;
        -*)             die "use: unknown option '$a' (try: ccex use -h)" ;;
        *)              [ -n "$target" ] && die "use takes one account, got '$target' and '$a'"; target=$a ;;
      esac
    done
    [ -n "$target" ] || die "usage: ccex use <account> [--dry-run] [--no-check]"
    if [ "$dry" = 1 ]; then
      use_acct "$target" --dry-run
      exit 0
    fi
    rc=0
    do_use "$target" $([ "$check" = 1 ] || echo --no-check) || rc=$?
    [ "$rc" = 3 ] && exit 0        # use_acct already said it was live; that is not a failure
    exit "$rc"
    ;;
  rm)
    [ $# -ge 1 ] || die "usage: ccex rm <name>"
    d=$(dir_for "$1")
    [ "$d" = "$BASE" ] && die "refusing to delete ~/.claude"
    [ -d "$d" ] || die "no such profile: $1"
    printf 'Delete %s (credentials + that profile'"'"'s own state; shared dirs are symlinks and survive)? [y/N] ' "$d"
    read -r a; [ "$a" = y ] || die "aborted"
    rm -rf "$d"
    ;;
  -h|--help|help)
    usage "${1:-}"
    ;;
  *) die "unknown command '$cmd' (try: ccex --help)" ;;
esac