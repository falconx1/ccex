#!/usr/bin/env bash
# ccex — "cc exchange": switch which Claude account Claude Code runs as.
# The live account is the ordinary ~/.claude; the others are parked under
# ~/.claude-profiles, sharing settings and history through symlinks.
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
CCEX_LIB=${CCEX_LIB:-$(dirname "$SELF")/../lib}
CCEX_PY="$CCEX_LIB/py"
export CCEX_BIN="$SELF"
[ -d "$CCEX_PY" ] || { printf 'ccex: cannot find its lib/ next to %s\n' "$SELF" >&2; exit 1; }

# shellcheck source=../lib/common.sh
for m in common profile limits rotate background; do . "$CCEX_LIB/$m.sh"; done

usage() {   # `ccex -h` for the overview, `ccex <command> -h` for one command
  case "${1:-}" in
    ls|list) cat <<'U'
ccex ls [<account>] [--force]
ccex ls -w|--watch [--every 5s] [--at N] [--refresh 15m] [--rotate]

With no account, every account as one row each:

  #         its number: `ccex use 3` is the whole switch
  ACCOUNT   slot name; * marks the live one, x one you held out of the rotation pool,
            X one rotation retired because its week is spent (`ccex pool in` revives it)
  TOKEN     access token: active, or stale until something uses the account
  REFRESH   when the login itself expires and needs a browser again
  5H        share of the 5-hour window spent, and how long until it resets
  WEEKLY    the same for the week
  CAP       5h/weekly percentages this account counts as out of room at, if it sets its
            own (`ccex pool cap`); the column is only there once something is capped
  CHECKED   how old those numbers are; `live` means a session is reporting now

Reads files only — never starts a session, however stale the numbers are, unless you
ask with --force. Name an account to get its two windows in full instead, with clock
times: `ccex ls work`.

-w keeps the table on screen, htop-style: the reset clocks count down every second,
the bars move as your sessions report, and the rotation monitor is folded in at the
bottom — which account is next, and how long until the live one hits the cap that
sends it there. That estimate comes from how fast the window is actually climbing, so
it needs a few minutes of readings before it can say.

  --every 10s   how often the numbers behind the countdown are re-read
  --at N        threshold to predict against; defaults to whatever `--bg` is running at
  --refresh 15m allow one real check when nothing has reported for that long (off by
                default, and never while the background daemon is doing it)
  --rotate      switch here, not just report it, when the live account is out of room

  up/down  move the selection, enter switches to it
  0-9      or type an account's number, y to confirm (backspace edits)
  +/-      re-pace it (10s, 30s, 1m, 5m, 15m, 30m)   r  re-read now    q  quit

Each row is one account by email, then each window as a percentage, a bar with a tick
where that account counts as out of room, and how long until it resets. `▶` marks the
account you are billing, `›` the one the arrows are on, and ROTATION says whether
rotation may choose it -- in pool, held, retired, or its own cap.

The estimate is about the 5-hour window, which is what actually stops you working; the
week only joins it once it is past 90%. Both read the same per-account caps rotation
does. Piped to a file it prints plain frames instead of drawing.
U
;;
    use) cat <<'U'
ccex use <account> [-n|--dry-run] [--no-check]

Hand the live ~/.claude slot to <account> and park whoever was there. <account> is the
number from `ccex ls`, a slot name, a full email, or any unambiguous prefix — `ccex use 3`
is the quickest.

  -n, --dry-run   say what would move, write nothing
  --no-check      skip the limits report afterwards

Sessions you already have open follow the switch.
U
;;
  rotate) cat <<'U'
ccex rotate [--at 80] [-n] [--bg|--watch|--status|--log|--stop]

Switch off the live account if it has crossed --at on the 5-hour or weekly window,
onto whichever account has the most usable room. With no flag it does that once, now.

  --at N        percentage that counts as out of room (default 80)
  -n            plan only, write nothing

An account with a cap of its own uses that instead of --at, in both directions -- see
`ccex pool -h`.

Keep it running:

  --bg          from now on, in the background: a resident service that switches as
                soon as a session reports the number that crosses the cap
  --watch       in this terminal, one line per check; 1-6 re-pace, r checks now, q quits
  --status      whether it is running, what it costs, and what it has rotated
  --log         every switch it has made
  --stop        remove it

  --every 10s   how often it re-reads the numbers (--bg), or prints a line (--watch)
  --refresh 15m allow one real check when nothing has reported for that long; off by
                default, because a switch now follows the data instead of a clock
  --serve       the loop --bg installs, in the foreground

`ccex ls -w` is the same thing with the whole table drawn, if you would rather watch it.

Candidates must be under --at on both windows. Among those, ranking is by what the
usage costs: used% x (time left in window / window length), 5-hour first, weekly as
the tie-break. Rotating once exits 1 if every account is spent.

Running in the background never starts a session to poll: it decides from what your
running sessions already report, and reads nothing but files to do it. It runs while
you are logged in; `loginctl enable-linger $USER` to keep it running when you are not.
U
;;
    record) cat <<'U'
ccex record [--install]

A statusline filter: Claude Code's payload in, the same payload out, the limits in it
noted on the way past. Every running session then keeps its own account's numbers
current, and nothing has to be launched to read them. Writes at most once every 15
seconds per account.

  --install   put it in front of your statusline in settings.json, once

Installing keeps whatever statusline you already have and pipes into it; with no
statusline it installs the bundled bar — model, context, cost, both usage windows.
settings.json is backed up first, and the line that undoes it is printed. Running it
again changes nothing. Without --install, this is the filter itself:

  "statusLine": { "type": "command", "command": "ccex record | your-statusline" }
U
;;
    pool) cat <<'U'
ccex pool out <account>    stop rotating onto that account
ccex pool in <account>     let it be chosen again
ccex pool cap <account> [--5h N] [--weekly N] [--clear]

Rotation rules for one account. The login is untouched by all of them — this is about what
`ccex rotate` may do, not about signing out.

out/in is the whole account: rotation will not choose a held one, and will not move you off
one you are sitting on, whatever its limits say. `ccex use` still switches to it by name.
Held accounts are marked x in `ccex ls`.

cap is the softer version — the account stays in rotation, but counts as out of room at its
own percentage instead of at --at:

  ccex pool cap 4 --5h 60 --weekly 99   leave 40% of every 5-hour window unspent on
                                        account 4, and let its week run to 99%
  ccex pool cap work --5h 95            or run one right down before moving on
  ccex pool cap work                    what it is capped at now
  ccex pool cap work --clear            back to the --at default

<account> here is the same as everywhere else: the number from `ccex ls`, a slot name, an
email, or any unambiguous prefix.

A cap applies both ways: rotation moves off that account once it crosses the cap, and will
not land on it above the cap either. Windows you don't cap keep following --at, so one
account can protect its week and share everyone else's 5-hour threshold. Capped accounts
are marked c in `ccex ls`, which also grows a CAP column showing 5h/weekly once anything is
capped -- `60/99` caps both, `-/25` only the week.
U
;;
    add) cat <<'U'
ccex add <name> [--email you@example.com]

Browser login for another account, parked under ~/.claude-profiles/<name>/ for later.
Its settings, history and plugins are symlinked to your real ones.

Run it again on a name that already exists to re-authenticate that account, which is
what an expired REFRESH date calls for.
U
;;
    run) cat <<'U'
ccex run <account> [claude args...]

Launch claude as a parked account, leaving the live one alone.
U
;;
    env) cat <<'U'
ccex env <account>

Print the CLAUDE_CONFIG_DIR line for that account: eval "$(ccex env work)"
U
;;
    *) cat <<'USAGE'
ccex — switch which Claude account Claude Code runs as

  ccex ls [<account>]         every account, or one in full; * marks the live one
  ccex ls -w                  that table live, counting down, with the next switch on it
  ccex use <account>          make that account live (-n to plan only)
  ccex rotate                 switch off the live account if it is out of room (--at 80)
  ccex rotate --bg            keep doing that in the background, the moment usage says so
  ccex pool out|in <account>  take an account out of the rotation pool, or put it back
  ccex pool cap <account>     how far rotation may spend that one account (--5h, --weekly)
  ccex add <name>             browser login for another account, parked for later
  ccex rm <account>           delete a parked account and its login
  ccex run <account> [args]   run claude as a parked account, leaving the live one alone
  ccex env <account>          eval "$(ccex env work)" to set CLAUDE_CONFIG_DIR
  ccex record                 statusline filter that keeps limits current for free
  ccex record --install       wire that filter into your statusline, once

  ccex <command> -h           what that command does, and its flags

<account> is the number from `ccex ls`, a slot name, a full email, or any unambiguous
prefix of either. Numbers are keyed to the account, so they survive rotations.

The live account is the ordinary ~/.claude; the rest are parked under ~/.claude-profiles
with settings, history and plugins symlinked back, so a switch changes nothing but who is
billed. `use` moves one key, claudeAiOauth, plus the matching identity block, and backs up
what it touches to ~/.claude-profiles/.backups/<timestamp>/. Sessions you already have
open follow the switch: they re-read the credential and bill the new account from their
next request on.

For live usage numbers at no cost, `ccex record --install` puts `ccex record |` in front of
your statusLine command in settings.json — see `ccex record -h`.
USAGE
;;
  esac
}

cmd=${1:-ls}; shift || true
case "$cmd" in
  run)                                 # hands its arguments to claude, -h included
    case "${1:-}" in -h|--help) usage "$cmd"; exit 0 ;; esac ;;
  *)
    for a in "$@"; do
      case "$a" in -h|--help) usage "$cmd"; exit 0 ;; esac
    done ;;
esac
case "$cmd" in
  ls|list)
    case " $* " in *" -w "*|*" --watch "*)     # the live view; everything below is the one-shot table
      wargs=()
      while [ $# -gt 0 ]; do
        case "$1" in
          -w|--watch) ;;
          --every|--refresh) [ $# -ge 2 ] || die "$1 needs a duration like 5s"
                             wargs+=("$1" "$(secs "$2")"); shift ;;
          --at)       [ $# -ge 2 ] || die "--at needs a percentage"; wargs+=(--at "$2"); shift ;;
          --rotate|--once) wargs+=("$1") ;;
          *)          die "ls: '$1' is not a --watch option (try: ccex ls -h)" ;;
        esac
        shift
      done
      exec python3 "$CCEX_PY/watch.py" ${wargs[@]+"${wargs[@]}"} ;;
    esac
    how=--no-launch; case " $* " in *" --force "*) how=--force ;; esac
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then limits --quiet "$how" "$@"; exit 0; fi
    cur="${CLAUDE_CONFIG_DIR:-$BASE}"
    declare -A ID FIVE SEVEN WHEN FLAGS CAP
    capcol=0
    while IFS=$'\t' read -r n i f s w g c; do
      ID[$n]=$i; FIVE[$n]=$f; SEVEN[$n]=$s; WHEN[$n]=$w; FLAGS[$n]=$g; CAP[$n]=$c
      [ "$c" != - ] && capcol=1        # nobody has capped anything: no column, same row as before
    done < <(limits --all --tsv "$how")
    hdr='%-3s %-2s%-18s %-30s %-7s %-7s %-8s %-22s %-26s '
    fmt='%-3s %-2s%-18s %-30s %-7s %-7s %-8s %s %s '
    [ "$capcol" = 1 ] && { hdr+='%-7s '; fmt+='%-7s '; }
    hdr+='%s\n'; fmt+='%s\n'
    capname=(); [ "$capcol" = 1 ] && capname=(CAP)
    # shellcheck disable=SC2059
    printf "$hdr" '#' '' ACCOUNT EMAIL TIER TOKEN REFRESH 5H WEEKLY \
      ${capname[@]+"${capname[@]}"} CHECKED
    while read -r p; do
      d=$(dir_for "$p")
      mark=' '; [ "$(readlink -f "$d" 2>/dev/null)" = "$(readlink -f "$cur" 2>/dev/null)" ] && mark='*'
      case ",${FLAGS[$p]:-}," in                 # held wins: a cap is moot on an account
        *,auto,*) mark="${mark% }X" ;;            # rotation retired it; `ccex pool in` revives it
        *,held,*) mark="${mark% }x" ;;            # you took it out; rotation may not choose it
        *,cap,*)  mark="${mark% }c" ;;
      esac
      IFS=$'\t' read -r email tier state rstate < <(info "$d")
      row=("${ID[$p]:--}" "$mark" "$p" "$email" "$tier" "$state" "$rstate" \
           "${FIVE[$p]:--}" "${SEVEN[$p]:--}")
      [ "$capcol" = 1 ] && row+=("${CAP[$p]:--}")
      row+=("${WHEN[$p]:--}")
      # shellcheck disable=SC2059
      printf "$fmt" "${row[@]}"
    done < <(profiles) | sort -n        # by id, so the numbers you type read in order
    ;;
  add)
    [ $# -ge 1 ] || die "usage: ccex add <name> [--email you@example.com]"
    name=$1; shift
    d=$(dir_for "$name")
    [ "$d" = "$BASE" ] && die "'default' is the existing ~/.claude account"
    link_shared "$d"
    seed "$d"
    printf 'ccex: logging in to profile %s (%s)\n' "$name" "$d" >&2
    CLAUDE_CONFIG_DIR="$d" claude auth login "$@"
    ;;
  run)
    [ $# -ge 1 ] || die "usage: ccex run <name> [claude args...]"
    d=$(dir_for "$1"); shift
    [ -d "$d" ] || die "no such profile dir: $d (run: ccex add)"
    if [ "$d" = "$BASE" ]; then exec env -u CLAUDE_CONFIG_DIR claude "$@"
    else link_shared "$d"; exec env CLAUDE_CONFIG_DIR="$d" claude "$@"; fi
    ;;
  env)
    [ $# -ge 1 ] || die "usage: eval \"\$(ccex env <name>)\""
    d=$(dir_for "$1")
    if [ "$d" = "$BASE" ]; then printf 'unset CLAUDE_CONFIG_DIR\n'
    else printf 'export CLAUDE_CONFIG_DIR=%q\n' "$d"; fi
    ;;
  record)
    case "${1:-}" in                     # --install must be handled before record() reads stdin
      --install) py statusline ;;
      '')        record ;;
      *)         die "record: unknown option '$1' (try: ccex record -h)" ;;
    esac
    ;;
  pool)
    case "${1:-}" in
      in|out) [ $# -ge 2 ] || die "usage: ccex pool $1 <account>"; py pool "$1" "$2" ;;
      cap)    [ $# -ge 2 ] || die "usage: ccex pool cap <account> [--5h N] [--weekly N] [--clear]"
              py pool "$@" ;;
      *)      die "usage: ccex pool in|out|cap <account>" ;;
    esac
    ;;
  rotate)
    mode=once; rest=()
    for a in "$@"; do
      case "$a" in
        --bg)     mode=install ;;
        --watch)  mode=watch ;;
        --serve)  mode=serve ;;      # what --bg installs: resident, switches on data change
        --status) mode=status ;;
        --log)    mode=log ;;
        --stop)   mode=stop ;;
        --tick)   mode=tick ;;      # what the timer runs: rotate once, then write the log
        --at|--every|--refresh|--max-age|-n|--dry-run|--no-launch)
                  rest+=("$a") ;;
        -*)       die "rotate: unknown option '$a' (try: ccex rotate -h)" ;;
        *)        rest+=("$a") ;;
      esac
    done
    if [ "$mode" = once ]; then rotate ${rest[@]+"${rest[@]}"}
    else monitor "$mode" ${rest[@]+"${rest[@]}"}; fi
    ;;
  use)
    [ $# -ge 1 ] || die "usage: ccex use <account> [--dry-run] [--no-check]"
    check=1; dry=0; target=
    for a in "$@"; do
      case "$a" in
        --no-check)     check=0 ;;
        -n|--dry-run)   dry=1 ;;
        -*)             die "use: unknown option '$a' (try: ccex use -h)" ;;
        *)              [ -n "$target" ] && die "use takes one account, got '$target' and '$a'"; target=$a ;;
      esac
    done
    [ -n "$target" ] || die "usage: ccex use <account> [--dry-run] [--no-check]"
    if [ "$dry" = 1 ]; then
      use_acct "$target" --dry-run
      exit 0
    fi
    rc=0
    do_use "$target" $([ "$check" = 1 ] || echo --no-check) || rc=$?
    [ "$rc" = 3 ] && exit 0        # use_acct already said it was live; that is not a failure
    exit "$rc"
    ;;
  rm)
    [ $# -ge 1 ] || die "usage: ccex rm <name>"
    d=$(dir_for "$1")
    [ "$d" = "$BASE" ] && die "refusing to delete ~/.claude"
    [ -d "$d" ] || die "no such profile: $1"
    printf 'Delete %s (credentials + that profile'"'"'s own state; shared dirs are symlinks and survive)? [y/N] ' "$d"
    read -r a; [ "$a" = y ] || die "aborted"
    py forget "$d" || true      # release its number and pool entry before the slot goes
    rm -rf "$d"
    ;;
  -h|--help|help)
    usage "${1:-}"
    ;;
  *) die "unknown command '$cmd' (try: ccex --help)" ;;
esac